---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Appearance — EchoFlow">
  <div class="settings-page">
    <header class="settings-header">
      <a href="/settings" class="back-link text-body-md">← Settings</a>
      <h1 class="text-title-lg">Appearance</h1>
      <p class="text-body-md subtitle">Theme & accent color</p>
    </header>

    <section class="section">
      <h2 class="text-title-md section-title">Theme</h2>
      <p class="text-body-sm section-desc">Echo Signal — EchoFlow's brand palette</p>

      <div class="theme-toggle-group" role="group" aria-label="Theme mode">
        <button type="button" class="theme-opt" data-set-theme="light">
          <span class="preview preview-light" />
          <span class="text-body-md">Light</span>
        </button>
        <button type="button" class="theme-opt" data-set-theme="dark">
          <span class="preview preview-dark" />
          <span class="text-body-md">Dark</span>
        </button>
      </div>
    </section>

    <section class="section">
      <h2 class="text-title-md section-title">Accent color</h2>
      <p class="text-body-sm section-desc">Echo Signal teal — the default EchoFlow identity</p>

      <div class="swatch-row">
        <div class="swatch selected" title="Echo Signal">
          <span class="swatch-wrap">
            <span class="swatch-color echo-signal" />
            <span class="check">✓</span>
          </span>
          <span class="text-body-sm swatch-label">Echo</span>
        </div>
        <div class="swatch muted" title="Other themes available in the app">
          <span class="swatch-color mono" />
          <span class="text-body-sm swatch-label">Mono</span>
        </div>
        <div class="swatch muted">
          <span class="swatch-color ocean" />
          <span class="text-body-sm swatch-label">Ocean</span>
        </div>
        <div class="swatch muted">
          <span class="swatch-color forest" />
          <span class="text-body-sm swatch-label">Forest</span>
        </div>
      </div>
      <p class="text-body-sm hint">This showcase only implements Echo Signal light & dark. The Android app keeps all accent palettes.</p>
    </section>

    <section class="section palette-preview">
      <h2 class="text-title-md section-title">Color roles</h2>
      <div class="role-grid">
        <div class="role-card primary">
          <span class="text-label-sm">Primary</span>
          <span class="text-body-sm">Send, links, user bubble</span>
        </div>
        <div class="role-card primary-container">
          <span class="text-label-sm">Primary container</span>
          <span class="text-body-sm">Active chips, icon buttons</span>
        </div>
        <div class="role-card secondary-container">
          <span class="text-label-sm">Secondary container</span>
          <span class="text-body-sm">Neutral chips, citations</span>
        </div>
        <div class="role-card tertiary-container">
          <span class="text-label-sm">Tertiary container</span>
          <span class="text-body-sm">Reasoning, Echo Adviser</span>
        </div>
        <div class="role-card surface">
          <span class="text-label-sm">Surface</span>
          <span class="text-body-sm">Page background</span>
        </div>
        <div class="role-card surface-high">
          <span class="text-label-sm">Surface high</span>
          <span class="text-body-sm">Composer, selected rows</span>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .settings-page {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-base) var(--space-xxl);
  }

  .settings-header {
    margin-bottom: var(--space-xl);
  }

  .back-link {
    display: inline-block;
    margin-bottom: var(--space-m);
    color: var(--primary);
  }

  .subtitle {
    color: var(--on-surface-variant);
    margin: var(--space-xs) 0 0;
  }

  .section {
    margin-bottom: var(--space-xl);
  }

  .section-title {
    margin: 0 0 var(--space-xs);
  }

  .section-desc {
    color: var(--on-surface-variant);
    margin: 0 0 var(--space-base);
  }

  .theme-toggle-group {
    display: flex;
    gap: var(--space-m);
  }

  .theme-opt {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    padding: var(--space-base);
    background: var(--surface-container);
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .theme-opt:hover {
    background: var(--surface-container-high);
  }

  .theme-opt.active {
    border-color: var(--primary);
    background: var(--surface-container-high);
  }

  .preview {
    width: 100%;
    height: 52px;
    border-radius: var(--radius-md);
    border: 1px solid var(--outline-variant);
  }

  .preview-light {
    background: linear-gradient(135deg, #faf9f6 50%, #b8ede4 100%);
  }

  .preview-dark {
    background: linear-gradient(135deg, #121110 50%, #005a4f 100%);
  }

  .swatch-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .swatch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    width: 72px;
  }

  .swatch.muted {
    opacity: 0.45;
  }

  .swatch-wrap {
    position: relative;
    width: 56px;
    height: 56px;
  }

  .swatch-color {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--outline-variant);
    display: block;
  }

  .swatch.selected .swatch-color {
    border-color: var(--primary);
    transform: scale(1.08);
  }

  .check {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 14px;
    font-weight: 700;
    pointer-events: none;
  }

  .echo-signal {
    background: #0a7c6e;
  }

  .mono {
    background: #1b1b1f;
  }

  .ocean {
    background: #1660a8;
  }

  .forest {
    background: #1c6e2e;
  }

  .swatch-label {
    color: var(--on-surface-variant);
  }

  .hint {
    margin-top: var(--space-m);
    color: var(--on-surface-variant);
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
  }

  .role-card {
    padding: var(--space-m);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-height: 72px;
  }

  .role-card span:last-child {
    opacity: 0.85;
  }

  .role-card.primary {
    background: var(--primary);
    color: var(--on-primary);
  }

  .role-card.primary-container {
    background: var(--primary-container);
    color: var(--on-primary-container);
  }

  .role-card.secondary-container {
    background: var(--secondary-container);
    color: var(--on-secondary-container);
  }

  .role-card.tertiary-container {
    background: var(--tertiary-container);
    color: var(--on-tertiary-container);
  }

  .role-card.surface {
    background: var(--surface);
    color: var(--on-surface);
    border: 1px solid var(--outline-variant);
  }

  .role-card.surface-high {
    background: var(--surface-container-high);
    color: var(--on-surface);
  }
</style>

<script>
  const STORAGE_KEY = "echoflow-theme";

  function setTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem(STORAGE_KEY, theme);
    document.querySelectorAll("[data-set-theme]").forEach((btn) => {
      btn.classList.toggle("active", btn.getAttribute("data-set-theme") === theme);
    });
  }

  const current = document.documentElement.getAttribute("data-theme") ?? "light";
  setTheme(current === "dark" ? "dark" : "light");

  document.querySelectorAll("[data-set-theme]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const t = btn.getAttribute("data-set-theme");
      if (t === "light" || t === "dark") setTheme(t);
    });
  });
</script>
