---
interface Props {
  label?: string;
}
const { label = "Toggle theme" } = Astro.props;
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label={label}>
  <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--surface-container-high);
    color: var(--on-surface);
    transition: background 0.15s ease;
  }

  .theme-toggle:hover {
    background: var(--surface-container-highest);
  }

  .icon-moon {
    display: none;
  }

  [data-theme="dark"] .icon-sun {
    display: none;
  }

  [data-theme="dark"] .icon-moon {
    display: block;
  }
</style>

<script>
  const STORAGE_KEY = "echoflow-theme";

  function getPreferred(): "light" | "dark" {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === "light" || stored === "dark") return stored;
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  }

  function applyTheme(theme: "light" | "dark") {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem(STORAGE_KEY, theme);
  }

  // Apply before paint on subsequent navigations
  applyTheme(getPreferred());

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme") ?? "light";
    applyTheme(current === "dark" ? "light" : "dark");
  });
</script>
