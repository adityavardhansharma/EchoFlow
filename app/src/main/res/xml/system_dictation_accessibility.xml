<?xml version="1.0" encoding="utf-8"?>
<!-- Dictation only needs focus and top-level window transitions. Content/window-list events
     are emitted continuously by Compose while typing and animating and add no information for
     deciding whether the bubble should be visible. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/system_dictation_description"
    android:accessibilityEventTypes="typeViewFocused|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100" />
