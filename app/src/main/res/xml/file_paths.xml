<?xml version="1.0" encoding="utf-8"?>
<!--
  Paths the app is allowed to hand to other apps through FileProvider. Project files are stored
  without an extension (their name is the doc id), so we never share them in place; instead we copy
  the one being opened into cache/shared_docs under its real display name and share that. Only that
  cache subfolder is exposed here, plus the camera
  folder the system camera writes chat photos into.
-->
<paths>
    <cache-path name="shared_docs" path="shared_docs/" />
    <!-- Photos taken from the chat "+" menu's Camera tile, written here by the camera app. -->
    <cache-path name="camera" path="camera/" />
    <!-- The upright, metadata-free copy of each chat photo, kept with the chat's messages. -->
    <files-path name="camera_photos" path="camera_photos/" />
</paths>
